{
  "$schema": "https://turbo.build/schema.json",
  "tasks": {
    "build": {
      "dependsOn": ["^build"],
      "env": ["NEXT_PUBLIC_API_URL"],
      "outputs": ["dist/**", ".next/**", "!.next/cache/**"]
    },
    "typecheck": { "dependsOn": ["^typecheck"] },
    "lint": {},
    "test": {
      "dependsOn": ["^build"],
      "passThroughEnv": ["INTEGRATION", "DATABASE_URL", "REDIS_URL"]
    },
    "dev": { "cache": false, "persistent": true }
  }
}
