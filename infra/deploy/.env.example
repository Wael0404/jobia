# ===== Copy to infra/deploy/.env (deploy.sh does it and generates the secrets) =====

# Public domain pointing to this server, e.g. jobia.duckdns.org (free at duckdns.org)
DOMAIN=
# Email used by Let's Encrypt for the HTTPS certificate
ACME_EMAIL=

# Google Cloud Console → APIs & Services → Credentials → OAuth client (Web application)
# Authorized redirect URI: https://<DOMAIN>/v1/auth/google/callback
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=

# console.anthropic.com → API keys (pay-as-you-go, set a monthly spend limit)
ANTHROPIC_API_KEY=
AI_MODEL=claude-opus-5-5

# Opt-in only, read docs/COMPLIANCE.md first
FEATURE_LINKEDIN_AUTOMATION=false
AGENT_MAX_APPLICATIONS_PER_DAY=20

# ----- Generated automatically by deploy.sh — do not share, back them up -----
POSTGRES_PASSWORD=
REDIS_PASSWORD=
MINIO_PASSWORD=
JWT_ACCESS_SECRET=
VAULT_MASTER_KEY=
