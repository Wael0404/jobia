# ---------- Shared ----------
NODE_ENV=development
LOG_LEVEL=info

# ---------- Data stores ----------
DATABASE_URL=postgres://jobia:jobia@localhost:5432/jobia
REDIS_URL=redis://localhost:6379

# ---------- Object storage (S3 / MinIO) ----------
S3_ENDPOINT=http://localhost:9000
S3_REGION=eu-west-3
S3_BUCKET=jobia-cvs
S3_ACCESS_KEY_ID=minio
S3_SECRET_ACCESS_KEY=minio123

# ---------- Auth ----------
JWT_ACCESS_SECRET=change-me-min-32-chars-long-access-secret
JWT_ACCESS_TTL_SECONDS=900
REFRESH_TOKEN_TTL_DAYS=30
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
LINKEDIN_CLIENT_ID=
LINKEDIN_CLIENT_SECRET=
PUBLIC_API_URL=http://localhost:4000
WEB_ORIGIN=http://localhost:3000

# Local demo only: "Essayer la démo" button without Google (refused when NODE_ENV=production)
DEMO_MODE=false
NEXT_PUBLIC_DEMO_MODE=false

# ---------- Credential vault ----------
# 32 bytes, base64. Generate with: openssl rand -base64 32
# In production, replace with a KMS-backed key (see docs/SECURITY.md).
VAULT_MASTER_KEY=

# ---------- AI ----------
ANTHROPIC_API_KEY=
AI_MODEL=claude-opus-5-5

# ---------- Agent guard-rails ----------
AGENT_MAX_APPLICATIONS_PER_DAY=40
AGENT_MIN_MATCH_SCORE=70
AGENT_DISCOVERY_INTERVAL_MINUTES=180
