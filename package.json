{
  "name": "jobia",
  "private": true,
  "packageManager": "pnpm@10.28.0",
  "engines": { "node": ">=22" },
  "scripts": {
    "build": "turbo run build",
    "dev": "turbo run dev --parallel",
    "lint": "turbo run lint",
    "typecheck": "turbo run typecheck",
    "test": "turbo run test",
    "db:generate": "pnpm --filter @jobia/db generate",
    "db:migrate": "pnpm --filter @jobia/db migrate"
  },
  "devDependencies": {
    "@types/node": "^22.10.0",
    "turbo": "^2.11.10",
    "typescript": "5.9.3",
    "vitest": "^5.1.0"
  }
}
